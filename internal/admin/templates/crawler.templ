package templates

import (
	"fmt"
	"etsi-rag/internal/domain"
)

// ProgressSnapshot mirrors crawler.ProgressSnapshot to avoid import cycle.
type ProgressSnapshot struct {
	Discovered  int64
	Fetched     int64
	CrawlFail   int64
	Parsed      int64
	ParseFail   int64
	Ingested    int64
	Skipped     int64
	EmbedFail   int64
	CrawlActive bool
	ParseActive bool
	EmbedActive bool
}

// CrawlerData bundles all data for the crawler page.
type CrawlerData struct {
	Running  bool
	DocCount int
	Sources  []domain.CrawlSource
	Runs     []domain.CrawlRun
	Progress *ProgressSnapshot
}

templ CrawlerPage(data CrawlerData) {
	@Layout("Crawler", "crawler") {
		@CrawlerContent(data)
	}
}

templ CrawlerContent(data CrawlerData) {
	@PageHeader("Crawler")
	<!-- Stats Row -->
	<div class="grid grid-cols-1 gap-6 sm:grid-cols-3 mb-6">
		@StatCardInt("Indexed Documents", data.DocCount)
		@StatCardInt("Crawl Sources", len(data.Sources))
		<div class="bg-white rounded-lg shadow p-6">
			<dt class="text-sm font-medium text-gray-500 mb-3">Controls</dt>
			<div class="flex gap-3">
				if data.Running {
					<button
						hx-delete="/admin/crawler/run"
						hx-target="#main"
						hx-swap="innerHTML"
						class="px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-md hover:bg-red-700"
					>
						Stop Crawl
					</button>
				} else {
					<button
						hx-post="/admin/crawler/run"
						hx-target="#main"
						hx-swap="innerHTML"
						class="px-4 py-2 text-sm font-medium text-white bg-green-600 rounded-md hover:bg-green-700"
					>
						Start Crawl
					</button>
				}
				<button
					hx-post="/admin/crawler/purge"
					hx-target="#main"
					hx-swap="innerHTML"
					hx-confirm="Purge all stale documents?"
					class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-md hover:bg-gray-200"
				>
					Purge Stale
				</button>
			</div>
		</div>
	</div>
	<!-- Live Status (polling trigger is inside the fragment, active only when running) -->
	<div id="crawler-status">
		@CrawlerStatusFragment(data.Running, data.Progress)
	</div>
	<!-- Sources Section -->
	<div class="mt-6">
		<div class="flex items-center justify-between mb-4">
			<h3 class="text-lg font-medium text-gray-900">Crawl Sources</h3>
			<button
				class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700"
				onclick="document.getElementById('source-form').classList.toggle('hidden')"
			>
				Add Source
			</button>
		</div>
		@SourceForm()
		@SourceTable(data.Sources)
	</div>
	<!-- Run History -->
	<div class="mt-6">
		<h3 class="text-lg font-medium text-gray-900 mb-4">Run History</h3>
		@RunTable(data.Runs)
	</div>
}

templ CrawlerStatusFragment(running bool, progress *ProgressSnapshot) {
	if running && progress != nil {
		<div
			hx-get="/admin/crawler/status"
			hx-trigger="every 2s"
			hx-target="#crawler-status"
			hx-swap="innerHTML"
			class="grid grid-cols-1 gap-4 sm:grid-cols-3"
		>
			@StageCard("Crawl", progress.CrawlActive, []StageStat{
				{Label: "Discovered", Value: progress.Discovered},
				{Label: "Fetched", Value: progress.Fetched},
				{Label: "Failed", Value: progress.CrawlFail},
			})
			@StageCard("Parse", progress.ParseActive, []StageStat{
				{Label: "Parsed", Value: progress.Parsed},
				{Label: "Failed", Value: progress.ParseFail},
			})
			@StageCard("Embed", progress.EmbedActive, []StageStat{
				{Label: "Ingested", Value: progress.Ingested},
				{Label: "Skipped", Value: progress.Skipped},
				{Label: "Failed", Value: progress.EmbedFail},
			})
		</div>
	} else if running {
		<div
			hx-get="/admin/crawler/status"
			hx-trigger="every 2s"
			hx-target="#crawler-status"
			hx-swap="innerHTML"
			class="bg-white rounded-lg shadow p-6"
		>
			<div class="flex items-center gap-2">
				<span class="relative flex h-3 w-3">
					<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
					<span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
				</span>
				<span class="text-sm text-gray-700">Starting...</span>
			</div>
		</div>
	} else {
		<!-- No hx-get/hx-trigger: polling stops when idle -->
		<div class="bg-white rounded-lg shadow p-6">
			<div class="flex items-center gap-2">
				<span class="inline-flex rounded-full h-3 w-3 bg-gray-400"></span>
				<span class="text-sm text-gray-500">Idle</span>
			</div>
		</div>
	}
}

templ SourceForm() {
	<div id="source-form" class="hidden bg-white rounded-lg shadow p-6 mb-6">
		<h3 class="text-lg font-medium text-gray-900 mb-4">New Source</h3>
		<form
			hx-post="/admin/crawler/sources"
			hx-target="#main"
			hx-swap="innerHTML"
			class="grid grid-cols-1 gap-4 sm:grid-cols-2"
		>
			<div>
				<label class="block text-sm font-medium text-gray-700">Name</label>
				<input
					type="text"
					name="name"
					required
					class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
					placeholder="My Source"
				/>
			</div>
			<div>
				<label class="block text-sm font-medium text-gray-700">Seed URL</label>
				<input
					type="url"
					name="seed_url"
					required
					class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
					placeholder="https://example.com/path"
				/>
			</div>
			<div>
				<label class="block text-sm font-medium text-gray-700">Category</label>
				<input
					type="text"
					name="category"
					class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
					placeholder="general"
				/>
			</div>
			<div>
				<label class="block text-sm font-medium text-gray-700">Language</label>
				<input
					type="text"
					name="language"
					value="es"
					class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
				/>
			</div>
			<div class="flex items-center gap-2 sm:col-span-2">
				<input type="checkbox" name="enabled" checked class="rounded border-gray-300 text-blue-600 focus:ring-blue-500"/>
				<label class="text-sm font-medium text-gray-700">Enabled</label>
			</div>
			<div class="sm:col-span-2">
				<button
					type="submit"
					class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700"
				>
					Create Source
				</button>
			</div>
		</form>
	</div>
}

templ SourceTable(sources []domain.CrawlSource) {
	<div class="bg-white rounded-lg shadow overflow-hidden">
		<table class="min-w-full divide-y divide-gray-200">
			<thead class="bg-gray-50">
				<tr>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Seed URL</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Category</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Language</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
				</tr>
			</thead>
			<tbody class="bg-white divide-y divide-gray-200">
				for _, src := range sources {
					<tr>
						<td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">{ src.Name }</td>
						<td class="px-6 py-4 text-sm text-gray-500 max-w-xs truncate">{ src.SeedURL }</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{ src.Category }</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{ src.Language }</td>
						<td class="px-6 py-4 whitespace-nowrap">
							@EnabledBadge(src.Enabled)
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm">
							<button
								hx-delete={ fmt.Sprintf("/admin/crawler/sources/%d", src.ID) }
								hx-target="#main"
								hx-swap="innerHTML"
								hx-confirm="Delete this source?"
								class="text-red-600 hover:text-red-900"
							>
								Delete
							</button>
						</td>
					</tr>
				}
				if len(sources) == 0 {
					<tr>
						<td colspan="6" class="px-6 py-4 text-center text-sm text-gray-500">No sources configured</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ RunTable(runs []domain.CrawlRun) {
	<div class="bg-white rounded-lg shadow overflow-hidden">
		<table class="min-w-full divide-y divide-gray-200">
			<thead class="bg-gray-50">
				<tr>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Started</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Finished</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Discovered</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Fetched</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Changed</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Failed</th>
				</tr>
			</thead>
			<tbody class="bg-white divide-y divide-gray-200">
				for _, run := range runs {
					<tr>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
							{ run.StartedAt.Format("2006-01-02 15:04") }
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
							if run.FinishedAt != nil {
								{ run.FinishedAt.Format("2006-01-02 15:04") }
							} else {
								—
							}
						</td>
						<td class="px-6 py-4 whitespace-nowrap">
							@RunStatusBadge(run.Status)
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
							{ fmt.Sprintf("%d", run.PagesDiscovered) }
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
							{ fmt.Sprintf("%d", run.PagesFetched) }
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
							{ fmt.Sprintf("%d", run.PagesChanged) }
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
							{ fmt.Sprintf("%d", run.PagesFailed) }
						</td>
					</tr>
				}
				if len(runs) == 0 {
					<tr>
						<td colspan="7" class="px-6 py-4 text-center text-sm text-gray-500">No runs yet</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}
