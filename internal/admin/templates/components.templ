package templates

import (
	"etsi-rag/internal/domain"
	"fmt"
)

// --- Buttons ---
templ BtnPrimary(label string, attrs templ.Attributes) {
	<button
		class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700 disabled:opacity-50"
		{ attrs... }
	>
		{ label }
	</button>
}

templ BtnDanger(label string, attrs templ.Attributes) {
	<button
		class="px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-md hover:bg-red-700 disabled:opacity-50"
		{ attrs... }
	>
		{ label }
	</button>
}

templ BtnSecondary(label string, attrs templ.Attributes) {
	<button
		class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-md hover:bg-gray-200 disabled:opacity-50"
		{ attrs... }
	>
		{ label }
	</button>
}

templ BtnSuccess(label string, attrs templ.Attributes) {
	<button
		class="px-4 py-2 text-sm font-medium text-white bg-green-600 rounded-md hover:bg-green-700 disabled:opacity-50"
		{ attrs... }
	>
		{ label }
	</button>
}

templ BtnWarning(label string, attrs templ.Attributes) {
	<button
		class="px-4 py-2 text-sm font-medium text-white bg-amber-600 rounded-md hover:bg-amber-700 disabled:opacity-50"
		{ attrs... }
	>
		{ label }
	</button>
}

// BtnLink renders a text-only action button for inline use (Edit, Delete, etc.).
templ BtnLink(label string, color string, attrs templ.Attributes) {
	switch color {
		case "blue":
			<button class="text-sm text-blue-600 hover:text-blue-800 hover:underline" { attrs... }>{ label }</button>
		case "red":
			<button class="text-sm text-red-600 hover:text-red-800 hover:underline" { attrs... }>{ label }</button>
		default:
			<button class="text-sm text-gray-600 hover:text-gray-800 hover:underline" { attrs... }>{ label }</button>
	}
}

// --- Form Fields ---
templ FormField(name, label, fieldType, value, placeholder string, required bool) {
	<div>
		<label class="block text-sm font-medium text-gray-700">{ label }</label>
		<input
			type={ fieldType }
			name={ name }
			value={ value }
			placeholder={ placeholder }
			required?={ required }
			class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm p-2"
		/>
	</div>
}

templ FormTextarea(name, label, value, placeholder, hint string, rows int) {
	<div class="sm:col-span-2">
		<label class="block text-sm font-medium text-gray-700">{ label }</label>
		<textarea
			name={ name }
			placeholder={ placeholder }
			rows={ fmt.Sprintf("%d", rows) }
			class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm p-2 font-mono text-xs"
		>{ value }</textarea>
		if hint != "" {
			<p class="mt-1 text-xs text-gray-500">{ hint }</p>
		}
	</div>
}

templ FormSelect(name, label, value string, options []string) {
	<div>
		<label class="block text-sm font-medium text-gray-700">{ label }</label>
		<select
			name={ name }
			class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm p-2"
		>
			<option value="">Select...</option>
			for _, opt := range options {
				<option value={ opt } selected?={ opt == value }>{ opt }</option>
			}
		</select>
	</div>
}

// FormModelSelect renders a model <select> that fetches available models from the
// selected backend when clicked. section namespaces the element ids so multiple
// config sections (embedding, agent) can coexist on the same page.
templ FormModelSelect(name, label, value, section string, backendNames []string) {
	<div>
		<label class="block text-sm font-medium text-gray-700">{ label }</label>
		<select
			id={ fmt.Sprintf("%s-model", section) }
			name={ name }
			hx-get="/admin/models"
			hx-trigger="focus"
			hx-target={ fmt.Sprintf("#%s-model", section) }
			hx-swap="innerHTML"
			hx-include={ fmt.Sprintf("#%s-backend, #%s-model-current", section, section) }
			class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm p-2"
		>
			if value != "" {
				<option value={ value } selected>{ value }</option>
			} else {
				<option value="">Select backend first...</option>
			}
		</select>
		<input type="hidden" id={ fmt.Sprintf("%s-model-current", section) } name="current" value={ value }/>
	</div>
}

// ModelOptions renders <option> elements for a model select.
templ ModelOptions(models []string, selected string) {
	if len(models) == 0 {
		if selected != "" {
			<option value={ selected } selected>{ selected }</option>
		}
		<option value="" disabled>No models available</option>
	} else {
		for _, m := range models {
			<option value={ m } selected?={ m == selected }>{ m }</option>
		}
		if selected != "" && !containsStr(models, selected) {
			<option value={ selected } selected>{ selected } (not on server)</option>
		}
	}
}

func containsStr(ss []string, s string) bool {
	for _, v := range ss {
		if v == s {
			return true
		}
	}
	return false
}

templ FormCheckbox(name, label string, checked bool) {
	<label class="flex items-center gap-2">
		<input
			type="checkbox"
			name={ name }
			value="true"
			checked?={ checked }
			class="rounded border-gray-300 text-blue-600 focus:ring-blue-500"
		/>
		<span class="text-sm text-gray-700">{ label }</span>
	</label>
}

// --- Badges ---
templ Badge(label string, color string) {
	switch color {
		case "green":
			<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">{ label }</span>
		case "red":
			<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">{ label }</span>
		case "blue":
			<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">{ label }</span>
		case "purple":
			<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">{ label }</span>
		case "yellow":
			<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">{ label }</span>
		default:
			<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">{ label }</span>
	}
}

templ StatusBadge(healthy bool) {
	if healthy {
		@Badge("Healthy", "green")
	} else {
		@Badge("Unhealthy", "red")
	}
}

templ EnabledBadge(enabled bool) {
	if enabled {
		@Badge("Enabled", "green")
	} else {
		@Badge("Disabled", "gray")
	}
}

templ BackendTypeBadge(isLlamaCpp bool) {
	if isLlamaCpp {
		@Badge("llama.cpp", "purple")
	} else {
		@Badge("OpenAI", "blue")
	}
}

templ RunStatusBadge(status domain.CrawlRunStatus) {
	switch status {
		case "completed":
			@Badge("Completed", "green")
		case "failed":
			@Badge("Failed", "red")
		case "running":
			@Badge("Running", "yellow")
		case "cancelled":
			@Badge("Cancelled", "gray")
		default:
			@Badge(string(status), "gray")
	}
}

// --- Cards ---
templ Card() {
	<div class="bg-white rounded-lg shadow">
		{ children... }
	</div>
}

templ CardWithHeader(title string) {
	<div class="bg-white rounded-lg shadow">
		<div class="px-6 py-4 border-b border-gray-200">
			<h3 class="text-lg font-medium text-gray-900">{ title }</h3>
		</div>
		{ children... }
	</div>
}

// --- Tables ---
templ TableWrap() {
	<div class="bg-white rounded-lg shadow overflow-x-auto">
		{ children... }
	</div>
}

templ Th(label string) {
	<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{ label }</th>
}

templ EmptyRow(colspan int, message string) {
	<tr>
		<td colspan={ fmt.Sprintf("%d", colspan) } class="px-6 py-8 text-center text-sm text-gray-500">
			{ message }
		</td>
	</tr>
}

// --- Toast ---
templ Toast(message string, kind string) {
	<div id="toast-container" hx-swap-oob="afterbegin">
		<div
			if kind == "success" {
				class="px-4 py-3 rounded-lg shadow-lg text-sm bg-green-600 text-white"
			}
			else
			if kind == "error" {
				class="px-4 py-3 rounded-lg shadow-lg text-sm bg-red-600 text-white"
			} else {
				class="px-4 py-3 rounded-lg shadow-lg text-sm bg-blue-600 text-white"
			}
			role="alert"
			remove-me="3s"
		>
			{ message }
		</div>
	</div>
}

// --- Page Header ---
templ PageHeader(title string) {
	<div class="mb-8">
		<h2 class="text-2xl font-bold text-gray-900">{ title }</h2>
	</div>
}

// --- Stats ---
templ StatCard(label string, value string) {
	<div class="bg-white rounded-lg shadow p-6">
		<dt class="text-sm font-medium text-gray-500 truncate">{ label }</dt>
		<dd class="mt-1 text-3xl font-semibold text-gray-900">{ value }</dd>
	</div>
}

templ StatCardInt(label string, value int) {
	@StatCard(label, fmt.Sprintf("%d", value))
}

// StageStat is a label/value pair for stage progress cards.
type StageStat struct {
	Label string
	Value int64
}

templ StageCard(name string, active bool, stats []StageStat) {
	<div class="bg-white rounded-lg shadow p-4 border-l-4 border-blue-500">
		<div class="flex items-center gap-2 mb-3">
			if active {
				@PulsingDot()
			} else {
				<span class="inline-flex rounded-full h-2.5 w-2.5 bg-gray-300"></span>
			}
			<h4 class="text-sm font-semibold text-gray-900">{ name }</h4>
		</div>
		<dl class="space-y-1">
			for _, s := range stats {
				<div class="flex justify-between text-sm">
					<dt class="text-gray-500">{ s.Label }</dt>
					<dd class="font-medium text-gray-900">{ fmt.Sprintf("%d", s.Value) }</dd>
				</div>
			}
		</dl>
	</div>
}

templ PulsingDot() {
	<span class="relative flex h-2.5 w-2.5">
		<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
		<span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-green-500"></span>
	</span>
}

// --- Collapsible ---

// Collapsible renders a <details> toggle with a primary-button-styled summary.
templ Collapsible(btnLabel string) {
	<details class="mb-6">
		<summary class="list-none cursor-pointer inline-flex px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700 select-none">
			{ btnLabel }
		</summary>
		<div class="mt-4">
			{ children... }
		</div>
	</details>
}
