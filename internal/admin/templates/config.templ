package templates

import "fmt"

type ConfigSection struct {
	Name   string
	Fields []ConfigField
}

type ConfigField struct {
	Key         string
	Label       string
	Value       string
	Type        string // "text", "number", "textarea"
	Placeholder string
}

templ ConfigPageTempl(sections []ConfigSection) {
	@Layout("Config", "config") {
		@ConfigContent(sections)
	}
}

templ ConfigContent(sections []ConfigSection) {
	@PageHeader("Configuration")
	<div class="space-y-6">
		for _, section := range sections {
			@ConfigSectionForm(section)
		}
	</div>
}

templ ConfigSectionForm(section ConfigSection) {
	<div class="bg-white rounded-lg shadow">
		<div class="px-6 py-4 border-b border-gray-200">
			<h3 class="text-lg font-medium text-gray-900 capitalize">{ section.Name }</h3>
		</div>
		<form
			hx-post={ fmt.Sprintf("/admin/config/%s", section.Name) }
			hx-target="#main"
			hx-swap="innerHTML"
			class="p-6"
		>
			<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
				for _, field := range section.Fields {
					<div>
						<label class="block text-sm font-medium text-gray-700">{ field.Label }</label>
						if field.Type == "textarea" {
							<textarea
								name={ field.Key }
								rows="3"
								class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm p-2 border"
								placeholder={ field.Placeholder }
							>{ field.Value }</textarea>
						} else {
							<input
								type={ field.Type }
								name={ field.Key }
								value={ field.Value }
								class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm p-2 border"
								placeholder={ field.Placeholder }
							/>
						}
					</div>
				}
			</div>
			<div class="mt-4 flex justify-end">
				<button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700">
					Save { section.Name }
				</button>
			</div>
		</form>
	</div>
}
