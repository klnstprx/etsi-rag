package templates

import "fmt"

type ConfigSection struct {
	Name   string
	Fields []ConfigField
}

type ConfigField struct {
	Key         string
	Label       string
	Value       string
	Type        string // "text", "number", "select", "textarea", "model"
	Placeholder string
	Options     []string // for Type == "select" or "model" (backend names)
}

templ ConfigPageTempl(sections []ConfigSection) {
	@Layout("Config", "config") {
		@ConfigContent(sections)
	}
}

templ ConfigContent(sections []ConfigSection) {
	@PageHeader("Configuration")
	<div class="space-y-6">
		for _, section := range sections {
			@ConfigSectionForm(section)
		}
	</div>
}

templ ConfigSectionForm(section ConfigSection) {
	@CardWithHeader(section.Name) {
		<form
			hx-post={ fmt.Sprintf("/admin/config/%s", section.Name) }
			hx-target="#main"
			hx-swap="innerHTML"
			class="p-6"
		>
			<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
				for _, field := range section.Fields {
					if field.Type == "select" {
						@ConfigBackendSelect(section.Name, field)
					} else if field.Type == "model" {
						@FormModelSelect(field.Key, field.Label, field.Value, section.Name, field.Options)
					} else if field.Type == "textarea" {
						@FormTextarea(field.Key, field.Label, field.Value, field.Placeholder, 4)
					} else {
						@FormField(field.Key, field.Label, field.Type, field.Value, field.Placeholder, false)
					}
				}
			</div>
			<div class="mt-4 flex justify-end">
				@BtnPrimary(fmt.Sprintf("Save %s", section.Name), templ.Attributes{"type": "submit"})
			</div>
		</form>
	}
}

// ConfigBackendSelect renders a backend <select>.
templ ConfigBackendSelect(section string, field ConfigField) {
	<div>
		<label class="block text-sm font-medium text-gray-700">{ field.Label }</label>
		<select
			id={ fmt.Sprintf("%s-backend", section) }
			name={ field.Key }
			class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm p-2"
		>
			<option value="">Select...</option>
			for _, opt := range field.Options {
				<option value={ opt } selected?={ opt == field.Value }>{ opt }</option>
			}
		</select>
	</div>
}
