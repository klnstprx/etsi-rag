package templates

templ Layout(title string, activePage string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full bg-gray-50">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } - ETSI RAG Admin</title>
			<link rel="stylesheet" href="/admin/static/styles.css"/>
			<script src="/admin/static/htmx.min.js"></script>
			<script src="/admin/static/htmx-sse.js"></script>
			<script src="/admin/static/htmx-remove-me.js"></script>
		</head>
		<body class="h-full" hx-ext="remove-me">
			<div class="flex h-full">
				@Sidebar(activePage)
				<main id="main" class="flex-1 overflow-y-auto p-8">
					{ children... }
				</main>
			</div>
			<div id="toast-container" class="fixed top-4 right-4 z-50 flex flex-col gap-2" aria-live="polite"></div>
		</body>
	</html>
}

templ Sidebar(activePage string) {
	<aside class="w-64 bg-gray-900 text-gray-300 flex flex-col shrink-0">
		<div class="p-4 border-b border-gray-700">
			<h1 class="text-lg font-bold text-white">ETSI RAG</h1>
			<p class="text-xs text-gray-500">Admin Panel</p>
		</div>
		<nav class="flex-1 p-4 space-y-1" aria-label="Main navigation" hx-boost="true">
			@NavLink("/admin/", "Dashboard", activePage == "dashboard")
			@NavLink("/admin/backends", "Backends", activePage == "backends")
			@NavLink("/admin/config", "Config", activePage == "config")
			@NavLink("/admin/documents", "Documents", activePage == "documents")
			@NavLink("/admin/crawler", "Crawler", activePage == "crawler")
			@NavLink("/admin/chat", "Chat", activePage == "chat")
		</nav>
		<div class="p-4 border-t border-gray-700 text-xs text-gray-500">
			<a href="/health" target="_blank" class="hover:text-gray-300">API Health</a>
		</div>
	</aside>
}

templ NavLink(href string, label string, active bool) {
	<a
		href={ templ.SafeURL(href) }
		if active {
			class="block px-3 py-2 rounded-md bg-gray-800 text-white text-sm font-medium"
		} else {
			class="block px-3 py-2 rounded-md text-sm hover:bg-gray-800 hover:text-white"
		}
	>
		{ label }
	</a>
}
