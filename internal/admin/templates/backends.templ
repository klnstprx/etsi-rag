package templates

import (
	"fmt"
	"net/url"
	"etsi-rag/internal/config"
)

templ BackendsPage(backends []config.BackendConfig) {
	@Layout("Backends", "backends") {
		@BackendsContent(backends)
	}
}

templ BackendsContent(backends []config.BackendConfig) {
	@PageHeader("Backends")
	<div class="mb-6">
		<button
			class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700"
			onclick="document.getElementById('backend-form').classList.toggle('hidden')"
		>
			Add Backend
		</button>
	</div>
	@BackendForm()
	@BackendTable(backends)
}

templ BackendForm() {
	<div
		id="backend-form"
		class="hidden bg-white rounded-lg shadow p-6 mb-6"
	>
		<h3 class="text-lg font-medium text-gray-900 mb-4">New Backend</h3>
		<form
			hx-post="/admin/backends"
			hx-target="#main"
			hx-swap="innerHTML"
			class="grid grid-cols-1 gap-4 sm:grid-cols-2"
		>
			<div>
				<label class="block text-sm font-medium text-gray-700">Name</label>
				<input
					type="text"
					name="name"
					required
					class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm p-2 border"
					placeholder="local-llama"
				/>
			</div>
			<div>
				<label class="block text-sm font-medium text-gray-700">Base URL</label>
				<input
					type="url"
					name="base_url"
					required
					class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm p-2 border"
					placeholder="http://localhost:8081/v1"
				/>
			</div>
			<div>
				<label class="block text-sm font-medium text-gray-700">API Key</label>
				<input
					type="password"
					name="api_key"
					class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm p-2 border"
					placeholder="Optional"
				/>
			</div>
			<div class="flex items-end">
				<label class="flex items-center gap-2">
					<input
						type="checkbox"
						name="enabled"
						value="true"
						checked
						class="rounded border-gray-300 text-blue-600 focus:ring-blue-500"
					/>
					<span class="text-sm text-gray-700">Enabled</span>
				</label>
			</div>
			<div class="sm:col-span-2 flex justify-end gap-3">
				<button
					type="button"
					class="px-3 py-2 text-sm text-gray-700 bg-gray-100 rounded-md hover:bg-gray-200"
					onclick="document.getElementById('backend-form').classList.add('hidden')"
				>
					Cancel
				</button>
				<button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700">
					Create
				</button>
			</div>
		</form>
	</div>
}

templ BackendRow(b config.BackendConfig) {
	<tr id={ fmt.Sprintf("backend-row-%s", b.Name) }>
		<td class="px-6 py-4 text-sm font-medium text-gray-900">{ b.Name }</td>
		<td class="px-6 py-4 text-sm text-gray-500">{ b.BaseURL }</td>
		<td class="px-6 py-4 text-sm text-gray-400 font-mono">{ config.MaskAPIKey(b.APIKey) }</td>
		<td class="px-6 py-4">
			@EnabledBadge(b.Enabled)
		</td>
		<td class="px-6 py-4" id={ fmt.Sprintf("health-%s", b.Name) }>
			<button
				hx-get={ fmt.Sprintf("/admin/backends/%s/health", url.PathEscape(b.Name)) }
				hx-target={ fmt.Sprintf("#health-%s", b.Name) }
				hx-swap="innerHTML"
				class="text-xs text-blue-600 hover:underline"
			>
				Check
			</button>
		</td>
		<td class="px-6 py-4 text-right text-sm space-x-2">
			<button
				hx-get={ fmt.Sprintf("/admin/backends/%s/edit", url.PathEscape(b.Name)) }
				hx-target="closest tr"
				hx-swap="outerHTML"
				class="text-blue-600 hover:text-blue-800"
			>
				Edit
			</button>
			<button
				hx-delete={ fmt.Sprintf("/admin/backends/%s", url.PathEscape(b.Name)) }
				hx-target="#main"
				hx-swap="innerHTML"
				hx-confirm="Delete this backend?"
				class="text-red-600 hover:text-red-800"
			>
				Delete
			</button>
		</td>
	</tr>
}

templ BackendEditRow(b config.BackendConfig) {
	<tr id={ fmt.Sprintf("backend-row-%s", b.Name) }>
		<td colspan="6" class="px-6 py-4">
			<h4 class="text-sm font-medium text-gray-900 mb-3">Edit Backend</h4>
			<form
				hx-put={ fmt.Sprintf("/admin/backends/%s", url.PathEscape(b.Name)) }
				hx-target="#main"
				hx-swap="innerHTML"
				class="grid grid-cols-1 gap-4 sm:grid-cols-2"
			>
				<div>
					<label class="block text-sm font-medium text-gray-700">Name</label>
					<input
						type="text"
						name="name"
						value={ b.Name }
						required
						class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm p-2 border"
					/>
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700">Base URL</label>
					<input
						type="url"
						name="base_url"
						value={ b.BaseURL }
						required
						class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm p-2 border"
					/>
				</div>
				<div>
					<label class="block text-sm font-medium text-gray-700">API Key</label>
					<input
						type="password"
						name="api_key"
						class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm p-2 border"
						placeholder="API key unchanged"
					/>
				</div>
				<div class="flex items-end">
					<label class="flex items-center gap-2">
						<input
							type="checkbox"
							name="enabled"
							value="true"
							if b.Enabled {
								checked
							}
							class="rounded border-gray-300 text-blue-600 focus:ring-blue-500"
						/>
						<span class="text-sm text-gray-700">Enabled</span>
					</label>
				</div>
				<div class="sm:col-span-2 flex justify-end gap-3">
					<button
						type="button"
						hx-get={ fmt.Sprintf("/admin/backends/%s", url.PathEscape(b.Name)) }
						hx-target="closest tr"
						hx-swap="outerHTML"
						class="px-3 py-2 text-sm text-gray-700 bg-gray-100 rounded-md hover:bg-gray-200"
					>
						Cancel
					</button>
					<button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700">
						Update
					</button>
				</div>
			</form>
		</td>
	</tr>
}

templ BackendTable(backends []config.BackendConfig) {
	<div id="backend-table" class="bg-white rounded-lg shadow overflow-hidden">
		<table class="min-w-full divide-y divide-gray-200">
			<thead class="bg-gray-50">
				<tr>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">URL</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">API Key</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
					<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Health</th>
					<th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
				</tr>
			</thead>
			<tbody class="divide-y divide-gray-200">
				if len(backends) == 0 {
					<tr>
						<td colspan="6" class="px-6 py-8 text-center text-sm text-gray-500">No backends configured</td>
					</tr>
				}
				for _, b := range backends {
					@BackendRow(b)
				}
			</tbody>
		</table>
	</div>
}
