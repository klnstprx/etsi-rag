package templates

import (
	"fmt"
	"net/url"
	"etsi-rag/internal/config"
)

templ BackendsPage(backends []config.BackendConfig) {
	@Layout("Backends", "backends") {
		@BackendsContent(backends)
	}
}

templ BackendsContent(backends []config.BackendConfig) {
	@PageHeader("Backends")
	@Collapsible("Add Backend") {
		@Card() {
			<div class="p-6">
				<h3 class="text-lg font-medium text-gray-900 mb-4">New Backend</h3>
				<form
					hx-post="/admin/backends"
					hx-target="#main"
					hx-swap="innerHTML"
					class="grid grid-cols-1 gap-4 sm:grid-cols-2"
				>
					@FormField("name", "Name", "text", "", "local-llama", true)
					@FormField("base_url", "Base URL", "url", "", "http://localhost:8081/v1", true)
					@FormField("api_key", "API Key", "password", "", "Optional", false)
					<div class="flex items-end gap-4">
						@FormCheckbox("enabled", "Enabled", true)
						@FormCheckbox("is_llama_cpp", "llama.cpp", false)
					</div>
					<div class="sm:col-span-2 flex justify-end">
						@BtnPrimary("Create", templ.Attributes{"type": "submit"})
					</div>
				</form>
			</div>
		}
	}
	@BackendTable(backends)
}

templ BackendRow(b config.BackendConfig) {
	<tr id={ fmt.Sprintf("backend-row-%s", b.Name) }>
		<td class="px-6 py-4 text-sm font-medium text-gray-900">{ b.Name }</td>
		<td class="px-6 py-4 text-sm text-gray-500">{ b.BaseURL }</td>
		<td class="px-6 py-4 text-sm text-gray-400 font-mono">{ config.MaskAPIKey(b.APIKey) }</td>
		<td class="px-6 py-4 space-x-1">
			@EnabledBadge(b.Enabled)
			@BackendTypeBadge(b.IsLlamaCpp)
		</td>
		<td class="px-6 py-4" id={ fmt.Sprintf("health-%s", b.Name) }>
			@BtnLink("Check", "blue", templ.Attributes{
				"hx-get":    fmt.Sprintf("/admin/backends/%s/health", url.PathEscape(b.Name)),
				"hx-target": fmt.Sprintf("#health-%s", b.Name),
				"hx-swap":   "innerHTML",
			})
		</td>
		<td class="px-6 py-4 text-right space-x-2">
			@BtnLink("Edit", "blue", templ.Attributes{
				"hx-get":    fmt.Sprintf("/admin/backends/%s/edit", url.PathEscape(b.Name)),
				"hx-target": "closest tr",
				"hx-swap":   "outerHTML",
			})
			@BtnLink("Delete", "red", templ.Attributes{
				"hx-delete":  fmt.Sprintf("/admin/backends/%s", url.PathEscape(b.Name)),
				"hx-target":  "#main",
				"hx-swap":    "innerHTML",
				"hx-confirm": "Delete this backend?",
			})
		</td>
	</tr>
}

templ BackendEditRow(b config.BackendConfig) {
	<tr id={ fmt.Sprintf("backend-row-%s", b.Name) }>
		<td colspan="6" class="px-6 py-4">
			<h4 class="text-sm font-medium text-gray-900 mb-3">Edit Backend</h4>
			<form
				hx-put={ fmt.Sprintf("/admin/backends/%s", url.PathEscape(b.Name)) }
				hx-target="#main"
				hx-swap="innerHTML"
				class="grid grid-cols-1 gap-4 sm:grid-cols-2"
			>
				@FormField("name", "Name", "text", b.Name, "", true)
				@FormField("base_url", "Base URL", "url", b.BaseURL, "", true)
				@FormField("api_key", "API Key", "password", "", "API key unchanged", false)
				<div class="flex items-end gap-4">
					@FormCheckbox("enabled", "Enabled", b.Enabled)
					@FormCheckbox("is_llama_cpp", "llama.cpp", b.IsLlamaCpp)
				</div>
				<div class="sm:col-span-2 flex justify-end gap-3">
					@BtnSecondary("Cancel", templ.Attributes{
						"type":      "button",
						"hx-get":    fmt.Sprintf("/admin/backends/%s", url.PathEscape(b.Name)),
						"hx-target": "closest tr",
						"hx-swap":   "outerHTML",
					})
					@BtnPrimary("Update", templ.Attributes{"type": "submit"})
				</div>
			</form>
		</td>
	</tr>
}

templ BackendTable(backends []config.BackendConfig) {
	@TableWrap() {
		<table class="min-w-full divide-y divide-gray-200">
			<thead class="bg-gray-50">
				<tr>
					@Th("Name")
					@Th("URL")
					@Th("API Key")
					@Th("Status")
					@Th("Health")
					<th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
				</tr>
			</thead>
			<tbody class="divide-y divide-gray-200">
				if len(backends) == 0 {
					@EmptyRow(6, "No backends configured")
				}
				for _, b := range backends {
					@BackendRow(b)
				}
			</tbody>
		</table>
	}
}
