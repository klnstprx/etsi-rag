package templates

import (
	"fmt"
	"time"

	"etsi-rag/internal/agent"
)

templ ChatPage(sessionID string) {
	@Layout("Chat", "chat") {
		@ChatContent(sessionID)
	}
}

templ ChatContent(sessionID string) {
	@PageHeader("Agent Chat")
	<div class="bg-white rounded-lg shadow flex flex-col" style="height: calc(100vh - 12rem);">
		<div id="chat-messages" class="flex-1 overflow-y-auto p-6 space-y-4">
			<div class="text-sm text-gray-500 text-center">Start a conversation with the RAG agent.</div>
		</div>
		<div class="border-t border-gray-200 p-4">
			<form
				hx-post="/admin/chat/send"
				hx-target="#chat-messages"
				hx-swap="beforeend scroll:bottom"
				hx-on:htmx:after-request="this.reset()"
				class="flex items-center gap-3"
			>
				<input type="hidden" name="session_id" value={ sessionID }/>
				<input
					type="text"
					name="message"
					required
					autocomplete="off"
					placeholder="Type a message..."
					class="flex-1 rounded-md border border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm p-2"
				/>
				<label class="flex items-center gap-2 text-xs text-gray-600 select-none whitespace-nowrap">
					<input
						type="checkbox"
						name="stream"
						checked
						class="rounded border-gray-300 text-blue-600 focus:ring-blue-500"
					/>
					Stream
				</label>
				@BtnPrimary("Send", templ.Attributes{"type": "submit"})
				@BtnSecondary("Reset", templ.Attributes{
					"type":    "button",
					"hx-post": "/admin/chat/reset",
					"hx-target": "#main",
					"hx-swap": "innerHTML",
				})
			</form>
		</div>
	</div>
}

templ UserMessage(text string) {
	<div class="flex justify-end">
		<div class="max-w-2xl rounded-lg px-4 py-2 bg-blue-600 text-white text-sm">
			{ text }
		</div>
	</div>
}

templ AssistantMessageSSE(sessionID string) {
	<div class="flex justify-start">
		<div
			class="assistant-thinking-host max-w-2xl w-full space-y-1"
			hx-ext="sse"
			sse-connect={ "/admin/chat/stream/" + sessionID }
			sse-close="done"
		>
			<div class="assistant-thinking flex items-center gap-1 rounded-lg px-4 py-2.5 bg-gray-100 w-fit" aria-label="Assistant is thinking">
				<span class="w-1.5 h-1.5 bg-gray-400 rounded-full animate-bounce"></span>
				<span class="w-1.5 h-1.5 bg-gray-400 rounded-full animate-bounce [animation-delay:150ms]"></span>
				<span class="w-1.5 h-1.5 bg-gray-400 rounded-full animate-bounce [animation-delay:300ms]"></span>
			</div>
			<div class="assistant-tools" sse-swap="tool_start,tool_done" hx-swap="beforeend scroll:#chat-messages:bottom"></div>
			<div
				class="assistant-bubble rounded-lg px-4 py-2 bg-gray-100 text-gray-900 text-sm whitespace-pre-wrap empty:hidden"
				sse-swap="token"
				hx-swap="beforeend scroll:#chat-messages:bottom"
			></div>
		</div>
	</div>
}

templ AssistantMessage(text string) {
	<div class="flex justify-start">
		<div class="max-w-2xl rounded-lg px-4 py-2 bg-gray-100 text-gray-900 text-sm whitespace-pre-wrap">
			{ text }
		</div>
	</div>
}

templ ToolCardLoading(callID string, name string) {
	<div id={ "tool-" + callID } class="flex items-center gap-2 px-3 py-1.5 rounded-md bg-blue-50 text-blue-700 text-xs">
		<svg class="animate-spin h-3 w-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
			<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
			<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
		</svg>
		<span class="font-medium">{ name }</span>
	</div>
}

templ ToolCardDone(callID string, name string, duration time.Duration, isError bool, citations []agent.Citation, images []agent.ImageRef, visionAttached bool) {
	<div id={ "tool-" + callID } hx-swap-oob="outerHTML">
		if isError {
			<div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-red-50 text-red-700 text-xs">
				<svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
				</svg>
				<span class="font-medium">{ name }</span>
				<span class="opacity-75">{ formatDuration(duration) }</span>
			</div>
		} else {
			<div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-green-50 text-green-700 text-xs">
				<svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
				</svg>
				<span class="font-medium">{ name }</span>
				<span class="opacity-75">{ formatDuration(duration) }</span>
			</div>
		}
		if len(citations) > 0 {
			<ul class="mt-1 ml-2 space-y-0.5 text-xs text-gray-700">
				for _, c := range citations {
					@citationItem(c)
				}
			</ul>
		}
		if len(images) > 0 {
			<div class="mt-2 ml-2 space-y-1">
				@imageBadge(visionAttached, len(images))
				<div class="flex flex-wrap gap-2">
					for _, img := range images {
						@imageThumb(img)
					}
				</div>
			</div>
		}
	</div>
}

// imageBadge surfaces whether the tool's images were actually forwarded to
// the LLM as image_url parts. When attached=false the user can see the
// images in the UI but knows the model couldn't read them — usually a
// SupportsVision or public_base_url misconfiguration.
templ imageBadge(attached bool, count int) {
	if attached {
		<span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-purple-50 text-purple-700 text-[11px] font-medium">
			<svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
				<path stroke-linecap="round" stroke-linejoin="round" d="M2 6l8 8 4-4 8 8M14 6h8v8"/>
			</svg>
			{ fmt.Sprintf("%d image%s attached to LLM", count, plural(count)) }
		</span>
	} else {
		<span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-amber-50 text-amber-700 text-[11px] font-medium" title="Images shown for reference. Set [agent].public_base_url and tick supports_vision on the backend to attach them as visual context.">
			<svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
				<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M5.07 19h13.86c1.54 0 2.5-1.67 1.73-3L13.73 4a2 2 0 00-3.46 0L3.34 16c-.77 1.33.19 3 1.73 3z"/>
			</svg>
			{ fmt.Sprintf("%d image%s available (vision off)", count, plural(count)) }
		</span>
	}
}

templ imageThumb(img agent.ImageRef) {
	<a href={ templ.SafeURL(img.URL) } target="_blank" rel="noopener noreferrer" class="block group" title={ img.DocID + " " + img.Ref }>
		<img src={ img.URL } alt={ img.DocID + " " + img.Ref }
			class="h-24 w-auto rounded border border-gray-300 group-hover:border-blue-500 transition-colors"
			loading="lazy"/>
		<div class="text-[10px] text-gray-500 mt-0.5 text-center">{ img.Ref }</div>
	</a>
}

func plural(n int) string {
	if n == 1 {
		return ""
	}
	return "s"
}

templ citationItem(c agent.Citation) {
	<li class="flex items-start gap-1.5">
		<span class="text-gray-400 select-none">↳</span>
		if c.URL != "" {
			<a href={ templ.SafeURL(c.URL) } target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:text-blue-800 hover:underline break-all">
				{ citationLabel(c) }
			</a>
		} else {
			<span class="break-all">{ citationLabel(c) }</span>
		}
	</li>
}

func citationLabel(c agent.Citation) string {
	if c.Title != "" {
		return c.Title
	}
	if c.URL != "" {
		return c.URL
	}
	return "(untitled source)"
}

func formatDuration(d time.Duration) string {
	if d < time.Second {
		return fmt.Sprintf("%dms", d.Milliseconds())
	}
	return fmt.Sprintf("%.1fs", d.Seconds())
}
