package templates

import (
	"fmt"
	"net/url"

	"etsi-rag/internal/domain"
	"etsi-rag/internal/store"
)

// DocumentsData bundles data for the documents list page.
//
// SourceOptions is the full source list (key + display name) used to populate
// the Source filter dropdown. SourceLabels maps source keys → display names so
// each row can render the source as text without having to scan the slice.
// SourceTags maps each source key → its tags, used to render per-row tag
// pills (the source's tags are the document's tags by inheritance).
// AllTags is the deduplicated, sorted set of tags across all sources, used to
// populate the Tag filter dropdown.
type DocumentsData struct {
	Documents     []store.DocumentSummary
	Total         int
	Page          int
	PageSize      int
	Search        string
	Source        string
	Tag           string
	SourceOptions []domain.CrawlSource
	SourceLabels  map[string]string
	SourceTags    map[string][]string
	AllTags       []string
}

// TotalPages returns the number of pages.
func (d DocumentsData) TotalPages() int {
	if d.Total == 0 {
		return 1
	}
	return (d.Total + d.PageSize - 1) / d.PageSize
}

// sourceLabel returns the display name for a source key, falling back to the
// key itself when the source is no longer in the registry (e.g. removed from
// sources.toml after the document was ingested).
func (d DocumentsData) sourceLabel(key string) string {
	if d.SourceLabels == nil {
		return key
	}
	if name, ok := d.SourceLabels[key]; ok && name != "" {
		return name
	}
	return key
}

// rowTags returns the tags for the source the document belongs to, or nil
// when the document has no source or the source is unknown.
func (d DocumentsData) rowTags(sourceKey *string) []string {
	if sourceKey == nil || d.SourceTags == nil {
		return nil
	}
	return d.SourceTags[*sourceKey]
}

// DocumentDetailData bundles data for a single document view.
type DocumentDetailData struct {
	Document   domain.Document
	Chunks     []domain.Chunk
	SourceKey  *string // nil when the document has no associated crawl_page
	SourceName string  // display name resolved from the registry; empty when unknown
	Tags       []string
}

templ DocumentsPage(data DocumentsData) {
	@Layout("Documents", "documents") {
		@DocumentsContent(data)
	}
}

templ DocumentsContent(data DocumentsData) {
	@PageHeader("Documents")
	<!-- Filter Bar -->
	<div class="flex items-center justify-between mb-6 gap-4 flex-wrap">
		<p class="text-sm text-gray-500">{ fmt.Sprintf("%d documents total", data.Total) }</p>
		<form
			class="flex gap-2 flex-wrap"
			hx-get="/admin/documents"
			hx-target="#main"
			hx-push-url="true"
		>
			<input
				type="text"
				name="q"
				value={ data.Search }
				placeholder="Search by title or URL..."
				class="rounded-md border border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm px-3 py-2"
			/>
			<select
				name="source"
				class="rounded-md border border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm px-3 py-2 bg-white"
			>
				<option value="">All sources</option>
				for _, src := range data.SourceOptions {
					if src.Key == data.Source {
						<option value={ src.Key } selected>{ src.Name }</option>
					} else {
						<option value={ src.Key }>{ src.Name }</option>
					}
				}
			</select>
			<select
				name="tag"
				class="rounded-md border border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm px-3 py-2 bg-white"
			>
				<option value="">All tags</option>
				for _, tag := range data.AllTags {
					if tag == data.Tag {
						<option value={ tag } selected>{ tag }</option>
					} else {
						<option value={ tag }>{ tag }</option>
					}
				}
			</select>
			@BtnPrimary("Apply", templ.Attributes{"type": "submit"})
			if data.Search != "" || data.Source != "" || data.Tag != "" {
				<a
					href="/admin/documents"
					hx-get="/admin/documents"
					hx-target="#main"
					hx-push-url="true"
					class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-md hover:bg-gray-200"
				>
					Clear
				</a>
			}
		</form>
	</div>
	<!-- Document Table -->
	@TableWrap() {
		<table class="min-w-full divide-y divide-gray-200">
			<thead class="bg-gray-50">
				<tr>
					@Th("Title")
					@Th("URL")
					@Th("Lang")
					@Th("Source")
					@Th("Tags")
					@Th("Chunks")
					@Th("Size")
					@Th("Actions")
				</tr>
			</thead>
			<tbody class="bg-white divide-y divide-gray-200">
				for _, doc := range data.Documents {
					<tr>
						<td class="px-6 py-4 text-sm font-medium text-gray-900 max-w-xs truncate" title={ doc.Title }>
							<a
								href={ templ.SafeURL(fmt.Sprintf("/admin/documents/%s", doc.ID)) }
								hx-get={ fmt.Sprintf("/admin/documents/%s", doc.ID) }
								hx-target="#main"
								hx-push-url="true"
								class="text-blue-600 hover:text-blue-800 hover:underline"
							>
								{ truncate(doc.Title, 60) }
							</a>
						</td>
						<td class="px-6 py-4 text-sm text-gray-500 max-w-xs truncate">
							if doc.URL != nil {
								<a href={ templ.SafeURL(*doc.URL) } target="_blank" class="hover:underline" title={ *doc.URL }>
									{ truncate(*doc.URL, 50) }
								</a>
							} else {
								<span class="text-gray-400">—</span>
							}
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{ string(doc.Language) }</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
							if doc.SourceKey != nil {
								{ data.sourceLabel(*doc.SourceKey) }
							} else {
								<span class="text-gray-400">—</span>
							}
						</td>
						<td class="px-6 py-4">
							@TagPills(data.rowTags(doc.SourceKey))
						</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{ fmt.Sprintf("%d", doc.ChunkCount) }</td>
						<td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{ formatSize(doc.ContentLen) }</td>
						<td class="px-6 py-4 whitespace-nowrap">
							@BtnLink("Delete", "red", templ.Attributes{
								"hx-delete":  fmt.Sprintf("/admin/documents/%s", doc.ID),
								"hx-target":  "#main",
								"hx-swap":    "innerHTML",
								"hx-confirm": "Delete this document and all its chunks?",
							})
						</td>
					</tr>
				}
				if len(data.Documents) == 0 {
					if data.Search != "" || data.Source != "" || data.Tag != "" {
						@EmptyRow(8, "No documents match your filters.")
					} else {
						@EmptyRow(8, "No documents indexed yet.")
					}
				}
			</tbody>
		</table>
	}
	<!-- Pagination -->
	if data.TotalPages() > 1 {
		<div class="mt-4 flex items-center justify-between">
			<p class="text-sm text-gray-700">
				{ fmt.Sprintf("Page %d of %d", data.Page, data.TotalPages()) }
			</p>
			<div class="flex gap-2">
				if data.Page > 1 {
					<a
						href={ templ.SafeURL(documentsPaginationURL(data.Page-1, data.Search, data.Source, data.Tag)) }
						hx-get={ documentsPaginationURL(data.Page-1, data.Search, data.Source, data.Tag) }
						hx-target="#main"
						hx-push-url="true"
						class="px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50"
					>
						Previous
					</a>
				}
				if data.Page < data.TotalPages() {
					<a
						href={ templ.SafeURL(documentsPaginationURL(data.Page+1, data.Search, data.Source, data.Tag)) }
						hx-get={ documentsPaginationURL(data.Page+1, data.Search, data.Source, data.Tag) }
						hx-target="#main"
						hx-push-url="true"
						class="px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50"
					>
						Next
					</a>
				}
			</div>
		</div>
	}
}

templ DocumentDetailPage(data DocumentDetailData) {
	@Layout("Document", "documents") {
		@DocumentDetailContent(data)
	}
}

templ DocumentDetailContent(data DocumentDetailData) {
	<!-- Breadcrumb -->
	<div class="mb-4">
		<a
			href="/admin/documents"
			hx-get="/admin/documents"
			hx-target="#main"
			hx-push-url="true"
			class="text-sm text-blue-600 hover:text-blue-800"
		>
			&larr; Back to Documents
		</a>
	</div>
	<div class="mb-8">
		<h2 class="text-2xl font-bold text-gray-900">{ data.Document.Title }</h2>
		<div class="mt-2 flex flex-wrap gap-4 text-sm text-gray-500 items-center">
			<span>ID: <code class="text-xs bg-gray-100 px-1 py-0.5 rounded">{ data.Document.ID }</code></span>
			<span>Language: { string(data.Document.Language) }</span>
			if data.SourceKey != nil {
				<span>
					Source:&nbsp;
					if data.SourceName != "" {
						{ data.SourceName }
					} else {
						{ *data.SourceKey }
					}
				</span>
			}
			if len(data.Tags) > 0 {
				<span class="flex items-center gap-2">
					Tags:&nbsp;
					@TagPills(data.Tags)
				</span>
			}
			if data.Document.URL != nil {
				<a href={ templ.SafeURL(*data.Document.URL) } target="_blank" class="text-blue-600 hover:underline">
					Source URL
				</a>
			}
		</div>
	</div>
	<!-- Full Content -->
	<div class="mb-8">
		<h3 class="text-lg font-medium text-gray-900 mb-3">
			Full Content
			<span class="text-sm font-normal text-gray-500">({ formatSize(len(data.Document.Content)) })</span>
		</h3>
		@Card() {
			<div class="p-6 max-h-96 overflow-y-auto">
				<pre class="text-sm text-gray-800 whitespace-pre-wrap break-words">{ data.Document.Content }</pre>
			</div>
		}
	</div>
	<!-- Chunks -->
	<div>
		<h3 class="text-lg font-medium text-gray-900 mb-3">
			Chunks
			<span class="text-sm font-normal text-gray-500">({ fmt.Sprintf("%d", len(data.Chunks)) })</span>
		</h3>
		<div class="space-y-4">
			for _, chunk := range data.Chunks {
				@Card() {
					<div class="p-4">
						<div class="flex items-center justify-between mb-2">
							<span class="text-xs font-medium text-gray-500">
								Chunk #{ fmt.Sprintf("%d", chunk.ChunkIndex) }
							</span>
							<span class="text-xs text-gray-400">
								{ formatSize(len(chunk.Content)) }
							</span>
						</div>
						<pre class="text-sm text-gray-700 whitespace-pre-wrap break-words max-h-48 overflow-y-auto">{ chunk.Content }</pre>
					</div>
				}
			}
			if len(data.Chunks) == 0 {
				<p class="text-sm text-gray-500">No chunks found for this document.</p>
			}
		</div>
	</div>
}

// truncate shortens a string to maxLen, appending "..." if truncated.
func truncate(s string, maxLen int) string {
	if len(s) <= maxLen {
		return s
	}
	return s[:maxLen-3] + "..."
}

// formatSize formats a byte count as a human-readable string.
func formatSize(bytes int) string {
	if bytes < 1024 {
		return fmt.Sprintf("%d B", bytes)
	}
	kb := float64(bytes) / 1024
	if kb < 1024 {
		return fmt.Sprintf("%.1f KB", kb)
	}
	mb := kb / 1024
	return fmt.Sprintf("%.1f MB", mb)
}

// documentsPaginationURL builds a pagination link preserving the active
// search, source, and tag filters so navigating pages does not reset state.
func documentsPaginationURL(page int, search, source, tag string) string {
	q := url.Values{}
	q.Set("page", fmt.Sprintf("%d", page))
	if search != "" {
		q.Set("q", search)
	}
	if source != "" {
		q.Set("source", source)
	}
	if tag != "" {
		q.Set("tag", tag)
	}
	return "/admin/documents?" + q.Encode()
}
